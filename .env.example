# Exchange
EXCHANGE=binance
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET=your_binance_secret

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# AI
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:latest
ANTHROPIC_API_KEY=your_anthropic_api_key   # fallback only

# Trading parameters
PAPER_TRADING=true
INITIAL_BALANCE=10000
RISK_PER_TRADE=0.01          # 1%
MAX_LEVERAGE=5
MAX_POSITIONS=3
MAX_SAME_DIRECTION=2

# Coins to watch (comma-separated)
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,AVAX/USDT

# Kill switches
MAX_DAILY_DRAWDOWN=0.03      # 3%
MAX_WEEKLY_DRAWDOWN=0.10     # 10%
MAX_MONTHLY_DRAWDOWN=0.15    # 15%
MAX_LOSS_STREAK=2

# Database
DATABASE_URL=sqlite+aiosqlite:///trading_bot.db
